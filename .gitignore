# Raw captures and large binaries are fetched by scripts/fetch_data.sh, never committed.
dataset/
data/
*.zip
*.mp4
*.mov
*.heic
*.HEIC

# Model weights, caches, outputs
weights/
checkpoints/
*.pt
*.pth
*.safetensors
out/
runs/
# Note: cache/vlm/ IS committed on purpose (deterministic replay of model outputs).

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS / editors
.DS_Store
.idea/
.vscode/

# Xcode (only relevant if we ever ship a Route 1 app)
xcuserdata/
*.ipa
*.dSYM
.build/

# Model-output checkpoints and extracted video frames (regenerable; can be large)
cache/
# Other Claude sessions' worktrees
.claude/worktrees/
